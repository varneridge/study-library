{
  "name": "study-library",
  "private": true,
  "version": "0.31.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fractional-indexing": "3.4.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.15.35",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "4.147.0"
  }
}
