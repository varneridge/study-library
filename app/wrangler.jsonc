{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "study-library",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
  		{
    		"binding": "DB",
    		"database_name": "study-library",
    		"database_id": "84aaf535-738c-4ec1-a0d2-62e58c54743d",
    		"migrations_dir": "migrations"
  		}
	],
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "study-library" }],
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"vars": {
		"ACCESS_TEAM_DOMAIN": "varneridge.cloudflareaccess.com",
		"ACCESS_AUD": "3513627ff53120f0b9c62fdfc6907230304f951a497877ad7de6cd86fa5f8b3c"
	},
	"observability": {
		"enabled": true
	}
}