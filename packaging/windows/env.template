# Study Library settings.
#
# This file is copied to %LOCALAPPDATA%\StudyLibrary\.env the first time the app
# starts and is never overwritten afterwards, so your values survive upgrades.
# It must never contain real secrets in the repository: every value here stays
# empty and each user fills in their own copy.
#
# A key preceded by a comment containing @required is checked at start-up, and
# the app offers to open this file in Notepad when any of them are empty.
#
# Replace the example keys below with the keys from the repository's
# .env.example (build.ps1 uses .env.example automatically when it exists).

# @required  Cloudflare R2 access key used for library sync
R2_ACCESS_KEY_ID=
# @required  Cloudflare R2 secret used for library sync
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
