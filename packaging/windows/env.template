# Study Library settings.
#
# This file is copied to %LOCALAPPDATA%\StudyLibrary\.env the first time the app
# starts and is never overwritten afterwards, so your values survive upgrades.
# It must never contain real secrets in the repository: every value here stays
# empty and each user fills in their own copy.
#
# The Worker's address.
STUDY_URL=https://study.samuelleigh.co.uk

# @required  Must match the PROCESSOR_KEY secret set on the Worker.
PROCESSOR_KEY=

# @required  Cloudflare Access service token client ID.
CF_ACCESS_CLIENT_ID=
# @required  Cloudflare Access service token client secret.
CF_ACCESS_CLIENT_SECRET=

# Keep the original scan after OCR.
KEEP_ORIGINAL_SCANS=false

# Parallel OCR processes. Match the server's CPU count.
OCR_JOBS=2

# Transcription. "openai" uses OPENAI_API_KEY. "local" runs faster-whisper here.
TRANSCRIBE_BACKEND=openai
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe

# Keep an uploaded lecture video after its audio is extracted.
KEEP_ORIGINAL_VIDEO=false

# Working out each reading's author, title and source.
IDENTIFY_OFFLINE=false

