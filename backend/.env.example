# The Worker's address.
STUDY_URL=https://study-library.yourname.workers.dev

# Must match the PROCESSOR_KEY secret set on the Worker.
PROCESSOR_KEY=

# Cloudflare Access service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Keep the original scan after OCR. OCR output keeps the original images,
# so the default deletes the original to save space.
KEEP_ORIGINAL_SCANS=false

# Parallel OCR processes. Match the server's CPU count.
OCR_JOBS=2

# Transcription. "openai" uses OPENAI_API_KEY. "local" runs faster-whisper here.
TRANSCRIBE_BACKEND=openai
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-transcribe

# Keep an uploaded lecture video after its audio is extracted.
KEEP_ORIGINAL_VIDEO=false

# Working out each reading's author, title and source. This uses Crossref's
# free public records and needs no key. Set to true to skip those lookups.
IDENTIFY_OFFLINE=false
